IDD_MEDIAPLAYER DIALOGEX 0, 0, 480, 332
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_ACCEPTFILES | WS_EX_APPWINDOW
CAPTION "メディアプレイヤー「らいら」"
FONT 9, "メイリオ", 400, 0, 0x80
BEGIN
    LTEXT           "タイトル",IDC_MP_TITLE,138,10,336,18,SS_NOTIFY | SS_ENDELLIPSIS
    LTEXT           "アーティスト",IDC_MP_ARTIST,138,32,336,12,SS_NOTIFY | SS_ENDELLIPSIS
    LTEXT           "アルバム",IDC_MP_ALBUM,138,46,336,12,SS_NOTIFY | SS_ENDELLIPSIS
    LTEXT           "　",IDC_MP_LRC,138,62,336,11,SS_NOTIFY
    LTEXT           "　",IDC_MP_LRC2,138,73,336,11,SS_NOTIFY
    LTEXT           "　",IDC_MP_LRC3,138,84,336,11,SS_NOTIFY
    LTEXT           "　",IDC_MP_LRC4,138,95,336,11,SS_NOTIFY
    LTEXT           "　",IDC_MP_LRC5,138,106,336,11,SS_NOTIFY
    LTEXT           "　",IDC_MP_OS,138,94,336,9,SS_NOTIFY
    LTEXT           "　",IDC_MP_CPU,138,104,336,9,SS_NOTIFY
    LTEXT           "　",IDC_MP_OS3,138,114,336,9,SS_NOTIFY
    CONTROL         "",IDC_MP_SEEK,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,7,128,420,12
    RTEXT           "00:00",IDC_MP_TIME,430,130,43,10
    PUSHBUTTON      "|<<",IDC_MP_PREV,7,146,40,18
    PUSHBUTTON      "再生",IDC_MP_PLAY,49,146,40,18
    PUSHBUTTON      "一時停止",IDC_MP_PAUSE,91,146,44,18
    PUSHBUTTON      "停止",IDC_MP_STOP,137,146,40,18
    PUSHBUTTON      ">>|",IDC_MP_NEXT,179,146,40,18
    CONTROL         "連続",IDC_MP_RENZOKU,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,148,40,8
    CONTROL         "ランダム",IDC_MP_RANDOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,274,148,48,8
    CONTROL         "ループ",IDC_MP_LOOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,228,158,44,8
    LTEXT           "ループ回数",IDC_MP_KAISUU_L,314,160,56,8
    EDITTEXT        IDC_MP_KAISUU,372,158,28,12,ES_AUTOHSCROLL | ES_NUMBER
